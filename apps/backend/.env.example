# ==========================================
# CAREER SERVICE CONFIGURATION (Port: 8080)
# ==========================================

PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/event_tracker_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

JWT_SECRET=your-64-byte-secret-key-that-matches-auth-service-hs512

CORS_ALLOWED_ORIGINS=http://localhost:5173,https://career-os.rohith.app

AI_EXTRACTION_SERVICE_URL=http://localhost:8082

# Adzuna Job Discovery API (Get free keys at developer.adzuna.com)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=in

MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password
