# ==========================================
# AUTH SERVICE CONFIGURATION (Port: 8081)
# ==========================================

AUTH_PORT=8081
AUTH_DB_URL=jdbc:postgresql://localhost:5432/career_os_auth_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

JWT_SECRET=your-64-byte-secret-key-that-matches-career-service-hs512

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

CORS_ALLOWED_ORIGINS=http://localhost:5173,https://career-os.rohith.app
OAUTH2_REDIRECT_URL=http://localhost:5173/oauth-success
